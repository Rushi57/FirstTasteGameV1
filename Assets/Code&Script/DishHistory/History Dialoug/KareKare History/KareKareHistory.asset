  m_Script: {fileID: 11500000, guid: 28f310e05cc019a48855581da30b411e, type: 3}
  m_Name: KareKareHistory
  m_EditorClassIdentifier: 
  lines:
  - text: 'Golden with annatto, thick with peanuts, '
    characterSprite: {fileID: 0}
  - text: "impossible without \u201Cbagoong\u201D. "
    characterSprite: {fileID: 0}
  - text: Kare-kare has been debated by scholars for decades.
    characterSprite: {fileID: 0}
  - text: ' Is it Kapampangan, Is it Indian, carried by sepoys who stayed after the British left Manila in 1764, '
    characterSprite: {fileID: 0}
  - text: Is it a cousin of Mexican mole brought over by the galleon ships,
    characterSprite: {fileID: 0}
  - text: The honest answer is yes, in different ways.
    characterSprite: {fileID: 0}
  - text: Can you build the sauce, time the vegetables,
    characterSprite: {fileID: 0}
  - text: and remember the one ingredient that must never be forgotten?
    characterSprite: {fileID: 0}
