  m_Script: {fileID: 11500000, guid: 28f310e05cc019a48855581da30b411e, type: 3}
  m_Name: ChickenAsadoHistory
  m_EditorClassIdentifier: 
  lines:
  - text: "Reflecting the 1565 \u2013 1815 Manila Galleon trade where New World tomatoes
      and Spanish,"
    characterSprite: {fileID: 0}
  - text: braising methods merged with local citrus and Chinese soy,
    characterSprite: {fileID: 0}
  - text: ' sauce during three centuries of colonial rule (1565 - 1898),'
    characterSprite: {fileID: 0}
  - text: this Kapampangan Sunday classic holds families together.
    characterSprite: {fileID: 0}
  - text: ' Can you balance the soy, calamansi, and tomato for the ideal sauce?'
    characterSprite: {fileID: 0}
