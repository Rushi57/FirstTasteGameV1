  m_Script: {fileID: 11500000, guid: 28f310e05cc019a48855581da30b411e, type: 3}
  m_Name: PancitPusitHistory
  m_EditorClassIdentifier: 
  lines:
  - text: "Dark as ink, briny as the sea. Pancit pusit, or \u201Cpancit choca\u201D as they call it in Cavite City,"
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: is a three-way conversation on a single plate.
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: Chinese noodle technique, Spanish squid-ink tradition from the old Manila Bay naval port,
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: and the deep Filipino love for fresh squid come together in one wok.
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: Can you draw the ink carefully, time the squid perfectly,
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: and get the noodles to drink in all that dark, briny flavor?
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
