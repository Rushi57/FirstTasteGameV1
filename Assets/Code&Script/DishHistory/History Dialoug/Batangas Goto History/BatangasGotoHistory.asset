  m_Script: {fileID: 11500000, guid: 28f310e05cc019a48855581da30b411e, type: 3}
  m_Name: BatangasGotoHistory
  m_EditorClassIdentifier: 
  lines:
  - text: 'A warm bowl on a cold morning. '
    characterSprite: {fileID: 0}
  - text: ' A quiet dish for the sick, the pregnant, and anyone needing care.'
    characterSprite: {fileID: 0}
  - text: Goto has fed Filipino families through long nights and gentle recoveries for generations.
    characterSprite: {fileID: 0}
  - text: Ox tripe, ginger, long-simmered rice, and the garlic and calamansi finish that makes it unmistakably ours.
    characterSprite: {fileID: 0}
  - text: Can you simmer the tripe just tender and coax the rice into that creamy,
    characterSprite: {fileID: 0}
  - text: ' comforting consistency we all remember from childhood?'
    characterSprite: {fileID: 0}
