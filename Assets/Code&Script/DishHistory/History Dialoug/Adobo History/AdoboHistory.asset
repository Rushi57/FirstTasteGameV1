  m_Script: {fileID: 11500000, guid: 28f310e05cc019a48855581da30b411e, type: 3}
  m_Name: AdoboHistory
  m_EditorClassIdentifier: 
  lines:
  - text: 'Every Filipino home knows this scent. '
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: Vinegar meeting garlic, patient simmering in a well-used pot,
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: 'flavors that only grow better by the next day. '
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: The dish you are about to make was already being cooked long before the,
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: Spaniards came and gave it the name we know today.
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: 'Each household holds its own version, each province its own twist. '
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: Will your careful hand and patient eye honor the recipe that has fed generations of Filipino families?
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
  - text: Let us find out.
    characterSprite: {fileID: -8056027616224820867, guid: 783feefcd5809a142b7b39ffbbe1c917, type: 3}
