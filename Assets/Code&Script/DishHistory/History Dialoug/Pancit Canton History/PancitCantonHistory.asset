  m_Script: {fileID: 11500000, guid: 28f310e05cc019a48855581da30b411e, type: 3}
  m_Name: PancitCantonHistory
  m_EditorClassIdentifier: 
  lines:
  - text: 'The one dish that must appear at every Filipino birthday party.  '
    characterSprite: {fileID: 0}
  - text: 'Long noodles for a long life, a Chinese tradition fully adopted and made our own. '
    characterSprite: {fileID: 0}
  - text: Pancit canton gets its name from Guangzhou and its soul from decades of Filipino family kitchens.
    characterSprite: {fileID: 0}
  - text: 'Pork, chicken, shrimp, cabbage, snow peas, soy sauce, oyster sauce, '
    characterSprite: {fileID: 0}
  - text: 'and that one squeeze of calamansi at the end. '
    characterSprite: {fileID: 0}
  - text: Ready to toss it all together without breaking a single noodle?
    characterSprite: {fileID: 0}
