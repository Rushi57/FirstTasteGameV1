MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 700999408}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a2c432a7cf400449bec8b2fdf491902, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyText: {fileID: 840974697}
  nextButton: {fileID: 61259920}
  characterImage: {fileID: 127801060}
  dishImage: {fileID: 197029645}
  storyPanel: {fileID: 968514305}
  gamePanel: {fileID: 673168197}
  lines:
  - text: Adobo is one of the oldest dishes in Philippine cuisine, with roots that
      reach back before the arrival of the Spanish colonizers
    characterSprite: {fileID: -511706578061346315, guid: ae71825725b21a3459805439433622ee, type: 3}
  - text: The name comes from the Spanish word "adobar," meaning to marinate or season.
    characterSprite: {fileID: -511706578061346315, guid: ae71825725b21a3459805439433622ee, type: 3}
  - text: But Filipinos were already cooking meat in vinegar long before that name
      arrived.
    characterSprite: {fileID: -511706578061346315, guid: ae71825725b21a3459805439433622ee, type: 3}
  - text: Filipino cooks have passed down recipes like Adobo.
    characterSprite: {fileID: -511706578061346315, guid: ae71825725b21a3459805439433622ee, type: 3}
  - text: Through generations, adjusting vinegar, soy sauce, and garlic to their
      family's taste.
    characterSprite: {fileID: -511706578061346315, guid: ae71825725b21a3459805439433622ee, type: 3}
  typeSpeed: 0.03
  enableAfterStory:
  - {fileID: 973146769}
  - {fileID: 1853911552}
  - {fileID: 1207282394}
  - {fileID: 1207282394}
  tutorialManager: {fileID: 1207282396}
